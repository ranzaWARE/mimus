+// _finishWithoutUpload marks a modified item as clean without uploading it
+// to its own name (mimus patch). The next open sees the cache as stale
+// and downloads the remote version.
+//
+// call with lock held
+func (item *Item) _finishWithoutUpload(current fs.Object, storeFn StoreFn) error {
+	item.o = current
+	if storeFn != nil && current != nil {
+		item.mu.Unlock()
+		storeFn(current)
+		item.mu.Lock()
+	}
+	item.info.Dirty = false
+	// a fingerprint that never matches: the next open drops the local data
+	// and downloads the remote version
+	item.info.Fingerprint = staleFingerprint
+	if err := item._save(); err != nil {
+		fs.Errorf(item.name, "vfs cache: failed to write metadata file: %v", err)
+	}
+	return nil
+}
+
+const staleFingerprint = "mimus:stale"
+
+// fingerprint returns the fingerprint of the remote version the cache
+// started from (mimus patch)
+func (item *Item) fingerprint() string {
+	item.mu.Lock()
+	defer item.mu.Unlock()
+	return item.info.Fingerprint
+}
+
+// adoptFingerprint sets the base fingerprint if the item has none: a file
+// renamed over an existing one (safe-save) is a new version of it
+// (mimus patch)
+func (item *Item) adoptFingerprint(fp string) {
+	item.mu.Lock()
+	defer item.mu.Unlock()
+	if item.info.Fingerprint == "" && fp != "" && fp != staleFingerprint {
+		item.info.Fingerprint = fp
+		_ = item._save()
+	}
+}
+
+// isOldCandidate reports whether the item could be removed by age:
+// not open, fully uploaded and not accessed for maxAge (mimus patch)
+func (item *Item) isOldCandidate(maxAge time.Duration) bool {
+	item.mu.Lock()
+	defer item.mu.Unlock()
+	if maxAge <= 0 || item.opens != 0 || item.info.Dirty {
+		return false
+	}
+	return item.info.ATime.Before(time.Now().Add(-maxAge))
+}
