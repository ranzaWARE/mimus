+func TestMimusOrphansRenamed(t *testing.T) {
+	ctx := context.Background()
+	opt := vfscommon.Opt
+	opt.CacheMode = vfscommon.CacheModeFull
+	opt.DirCacheTime = fs.Duration(time.Millisecond)
+	r := fstest.NewRun(t)
+	pf := &pinFs{Fs: r.Fremote, pins: map[string]bool{}}
+	vfs := New(pf, &opt)
+	t.Cleanup(func() { cleanupVFS(t, vfs) })
+	a := r.WriteObject(ctx, "dir/a.txt", "contenuto a", t1)
+	r.WriteObject(ctx, "dir/b.txt", "contenuto b!", t1)
+	fsp := rc.Params{"fs": fs.ConfigString(pf)}
+	_, err := rc.Calls.Get("vfs/mimus-download").Fn(ctx, rc.Params{"fs": fs.ConfigString(pf), "path": "dir"})
+	require.NoError(t, err)
+
+	// a.txt renamed on the server by someone else (same size and date)
+	o, err := r.Fremote.NewObject(ctx, a.Path)
+	require.NoError(t, err)
+	_, err = r.Fremote.Features().Move(ctx, o, "dir/a-nuovo.txt")
+	require.NoError(t, err)
+	time.Sleep(10 * time.Millisecond)
+	out, err := rc.Calls.Get("vfs/mimus-orphans").Fn(ctx, fsp)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"dir/a-nuovo.txt"}, out["renamed"])
+	assert.Equal(t, []string{}, out["removed"])
+	assert.Equal(t, MimusLocal, vfs.mimusState("dir/a-nuovo.txt"))
+	assert.False(t, vfs.cache.State("dir/a.txt").Known)
+
+	// the copy is the right one: read without downloading
+	h, err := vfs.OpenFile("dir/a-nuovo.txt", os.O_RDONLY, 0)
+	require.NoError(t, err)
+	buf := make([]byte, 64)
+	n, _ := h.Read(buf)
+	require.NoError(t, h.Close())
+	assert.Equal(t, "contenuto a", string(buf[:n]))
+}
+
+// a file deleted on the server and another one with the same size and date
+// but different content: not a rename, the copy must not take the new name
+func TestMimusOrphansNotRenamed(t *testing.T) {
+	ctx := context.Background()
+	opt := vfscommon.Opt
+	opt.CacheMode = vfscommon.CacheModeFull
+	opt.DirCacheTime = fs.Duration(time.Millisecond)
+	opt.FastFingerprint = true // size and date only, as on SMB
+	r := fstest.NewRun(t)
+	pf := &pinFs{Fs: r.Fremote, pins: map[string]bool{}}
+	vfs := New(pf, &opt)
+	t.Cleanup(func() { cleanupVFS(t, vfs) })
+	big := strings.Repeat("x", 300*1024)
+	a := r.WriteObject(ctx, "dir/a.dat", "AAAAAAAAAA", t1)
+	g := r.WriteObject(ctx, "dir/g.dat", big, t1)
+	fsp := rc.Params{"fs": fs.ConfigString(pf)}
+	_, err := rc.Calls.Get("vfs/mimus-download").Fn(ctx, rc.Params{"fs": fs.ConfigString(pf), "path": "dir"})
+	require.NoError(t, err)
+
+	// small file: different everywhere
+	r.WriteObject(ctx, "dir/b.dat", "BBBBBBBBBB", t1)
+	// big file: different only in the middle
+	r.WriteObject(ctx, "dir/h.dat", big[:150*1024]+"y"+big[150*1024+1:], t1)
+	for _, it := range []fstest.Item{a, g} {
+		o, err := r.Fremote.NewObject(ctx, it.Path)
+		require.NoError(t, err)
+		require.NoError(t, o.Remove(ctx))
+	}
+	time.Sleep(10 * time.Millisecond)
+	out, err := rc.Calls.Get("vfs/mimus-orphans").Fn(ctx, fsp)
+	require.NoError(t, err)
+	assert.Equal(t, []string{}, out["renamed"])
+	assert.Equal(t, []string{"dir/a.dat", "dir/g.dat"}, out["removed"])
+	for name, want := range map[string]string{"dir/b.dat": "BBBBBBBBBB", "dir/h.dat": big[:150*1024] + "y" + big[150*1024+1:]} {
+		h, err := vfs.OpenFile(name, os.O_RDONLY, 0)
+		require.NoError(t, err)
+		got, err := io.ReadAll(h)
+		require.NoError(t, err)
+		require.NoError(t, h.Close())
+		assert.True(t, string(got) == want, name)
+	}
+}
+
+// a change in the middle of a file not on this computer: the rest comes
+// from the version being changed, even if the server has a newer one by the
+// time it is uploaded
+func TestMimusWriteCompletesCopy(t *testing.T) {
+	ctx := context.Background()
+	opt := vfscommon.Opt
+	opt.CacheMode = vfscommon.CacheModeFull
+	opt.WriteBack = fs.Duration(100 * time.Millisecond)
+	r := fstest.NewRun(t)
+	vfs := New(r.Fremote, &opt)
+	t.Cleanup(func() { cleanupVFS(t, vfs) })
+	orig := strings.Repeat("a", 300*1024)
+	r.WriteObject(ctx, "big.txt", orig, t1)
+
+	h, err := vfs.OpenFile("big.txt", os.O_RDWR, 0)
+	require.NoError(t, err)
+	_, err = h.WriteAt([]byte("X"), 1000)
+	require.NoError(t, err)
+	assert.True(t, vfs.cache.State("big.txt").Complete)
+	// someone else changes it meanwhile
+	r.WriteObject(ctx, "big.txt", strings.Repeat("b", 300*1024), t2)
+	require.NoError(t, h.Close())
+
+	want := orig[:1000] + "X" + orig[1001:]
+	var got string
+	for i := 0; i < 100; i++ {
+		o, err := r.Fremote.NewObject(ctx, "big.txt")
+		require.NoError(t, err)
+		in, err := o.Open(ctx)
+		require.NoError(t, err)
+		b, _ := io.ReadAll(in)
+		_ = in.Close()
+		if got = string(b); got == want {
+			break
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	assert.True(t, got == want, "uploaded file mixes two versions")
+}
+
+// many files gone from the server at once: the copies stay (unless forced)
+func TestMimusOrphansMassGone(t *testing.T) {
+	ctx := context.Background()
+	opt := vfscommon.Opt
+	opt.CacheMode = vfscommon.CacheModeFull
+	opt.DirCacheTime = fs.Duration(time.Millisecond)
+	r := fstest.NewRun(t)
+	pf := &pinFs{Fs: r.Fremote, pins: map[string]bool{}}
+	vfs := New(pf, &opt)
+	t.Cleanup(func() { cleanupVFS(t, vfs) })
+	var items []fstest.Item
+	for i := 0; i < 30; i++ {
+		items = append(items, r.WriteObject(ctx, fmt.Sprintf("dir/f%02d.txt", i), fmt.Sprintf("contenuto %d", i), t1))
+	}
+	fsp := rc.Params{"fs": fs.ConfigString(pf)}
+	_, err := rc.Calls.Get("vfs/mimus-download").Fn(ctx, rc.Params{"fs": fs.ConfigString(pf), "path": "dir"})
+	require.NoError(t, err)
+	for _, it := range items[:25] {
+		o, err := r.Fremote.NewObject(ctx, it.Path)
+		require.NoError(t, err)
+		require.NoError(t, o.Remove(ctx))
+	}
+	time.Sleep(10 * time.Millisecond)
+	out, err := rc.Calls.Get("vfs/mimus-orphans").Fn(ctx, fsp)
+	require.NoError(t, err)
+	assert.Len(t, out["held"], 25)
+	assert.Equal(t, []string{}, out["removed"])
+	assert.True(t, vfs.cache.State("dir/f00.txt").Complete)
+
+	fsp["force"] = true
+	out, err = rc.Calls.Get("vfs/mimus-orphans").Fn(ctx, fsp)
+	require.NoError(t, err)
+	assert.Len(t, out["removed"], 25)
+	assert.False(t, vfs.cache.State("dir/f00.txt").Cached)
+	assert.True(t, vfs.cache.State("dir/f29.txt").Complete)
+}
+
+// a file put in place of another (safe-save) never overwrites a version of
+// that file changed meanwhile by someone else
+func TestMimusRenameOverChanged(t *testing.T) {
+	ctx := context.Background()
+	opt := vfscommon.Opt
+	opt.CacheMode = vfscommon.CacheModeFull
+	opt.DirCacheTime = fs.Duration(time.Hour)
+	opt.WriteBack = fs.Duration(3 * time.Second) // new files stay local for a while
+	r := fstest.NewRun(t)
+	vfs := New(r.Fremote, &opt)
+	t.Cleanup(func() { cleanupVFS(t, vfs) })
+	r.WriteObject(ctx, "dir/a.txt", "versione 1", t1)
+	r.WriteObject(ctx, "dir/nuovo.txt", "versione del Mac", t1)
+	r.WriteObject(ctx, "dir/b.txt", "versione 1", t1)
+	_, err := vfs.Stat("dir/a.txt") // the Mac has seen the folder
+	require.NoError(t, err)
+	b1, err := r.Fremote.NewObject(ctx, "dir/b.txt")
+	require.NoError(t, err)
+	knownB := fs.Fingerprint(ctx, b1, false)
+
+	// already on the server: a colleague changed a.txt meanwhile
+	r.WriteObject(ctx, "dir/a.txt", "versione del collega", t2)
+	require.NoError(t, vfs.Rename("dir/nuovo.txt", "dir/a.txt"))
+	entries, err := r.Fremote.List(ctx, "dir")
+	require.NoError(t, err)
+	found := false
+	for _, e := range entries {
+		if strings.HasPrefix(path.Base(e.Remote()), "a (versione di un collega ") {
+			found = true
+		}
+	}
+	assert.True(t, found, "colleague's version set aside")
+
+	// not uploaded yet: carries the replaced version as base
+	h, err := vfs.OpenFile("dir/b.tmp", os.O_CREATE|os.O_WRONLY, 0o644)
+	require.NoError(t, err)
+	_, err = h.Write([]byte("versione del Mac"))
+	require.NoError(t, err)
+	require.NoError(t, h.Close())
+	require.NoError(t, vfs.Rename("dir/b.tmp", "dir/b.txt"))
+	assert.Equal(t, knownB, vfs.cache.State("dir/b.txt").Fingerprint)
+}
+
+// names Windows reserves are refused, not created and then shown mangled
+func TestMimusReservedNames(t *testing.T) {
+	for name, want := range map[string]bool{
+		"CON": true, "con.txt": true, "Aux.doc": true, "nul": true, "COM1.log": true,
+		"lpt9": true, "LPT1.tar.gz": true, "prn ": true,
+		"CONSOLE.txt": false, "contratto.docx": false, "COM10": false, "aux_file": false, "a.CON": false,
+	} {
+		assert.Equal(t, want, mimusReservedName(name), name)
+	}
+	opt := vfscommon.Opt
+	opt.CacheMode = vfscommon.CacheModeFull
+	r := fstest.NewRun(t)
+	vfs := New(r.Fremote, &opt)
+	t.Cleanup(func() { cleanupVFS(t, vfs) })
+	_, err := vfs.OpenFile("CON.txt", os.O_CREATE|os.O_WRONLY, 0o644)
+	assert.Error(t, err)
+	assert.Error(t, vfs.Mkdir("aux", 0o755))
+	h, err := vfs.OpenFile("normale.txt", os.O_CREATE|os.O_WRONLY, 0o644)
+	require.NoError(t, err)
+	require.NoError(t, h.Close())
+	assert.Error(t, vfs.Rename("normale.txt", "nul.txt"))
+}
