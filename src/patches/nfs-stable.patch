+// mimusMountNames: the mountpoint as given and as the mount table shows it
+// (on macOS /var is /private/var). Only the parent is resolved: the folder
+// itself may be a dead mount, where any access can hang.
+func mimusMountNames(mountpoint string) []string {
+	names := []string{mountpoint}
+	if parent, err := filepath.EvalSymlinks(filepath.Dir(mountpoint)); err == nil {
+		if real := filepath.Join(parent, filepath.Base(mountpoint)); real != mountpoint {
+			names = append(names, real)
+		}
+	}
+	return names
+}
+
+// mimusIsMounted reads the mount table (never touches the folder)
+func mimusIsMounted(mountpoint string) bool {
+	out, err := exec.Command("mount").Output()
+	if err != nil {
+		return false
+	}
+	for _, name := range mimusMountNames(mountpoint) {
+		if bytes.Contains(out, []byte(" on "+name+" ")) {
+			return true
+		}
+	}
+	return false
+}
+
+// mimusUnmount unmounts, insisting: diskutil sometimes refuses while the
+// Finder uses the folder, umount -f does not
+func mimusUnmount(mountpoint string) error {
+	var last error
+	for try := 0; try < 4; try++ {
+		var cmds [][]string
+		if runtime.GOOS == "darwin" {
+			cmds = append(cmds, []string{"diskutil", "unmount", "force", mountpoint})
+		}
+		umount := []string{"umount", "-f", mountpoint}
+		if sudo {
+			umount = append([]string{"sudo"}, umount...)
+		}
+		cmds = append(cmds, umount)
+		for _, c := range cmds {
+			out, err := exec.Command(c[0], c[1:]...).CombinedOutput()
+			if err == nil && !mimusIsMounted(mountpoint) {
+				return nil
+			}
+			if err != nil {
+				last = fmt.Errorf("%s: %s: %w", c[0], bytes.TrimSpace(out), err)
+			}
+		}
+		if !mimusIsMounted(mountpoint) {
+			return nil
+		}
+		time.Sleep(time.Second)
+	}
+	if last == nil {
+		last = fmt.Errorf("%s still mounted", mountpoint)
+	}
+	return last
+}
+
+// mimusFixedPort: the NFS server listens on a fixed port (--addr host:port)
+func mimusFixedPort() bool {
+	_, port, err := net.SplitHostPort(nfs.Opt.ListenAddr)
+	return err == nil && port != "" && port != "0"
+}
+
+// mimusAnswers: the mount at mountpoint is served by this process. A
+// lookup of a name that does not exist must come back "not found" in time:
+// a dead mount hangs, one with handles unknown here says "stale".
+func mimusAnswers(mountpoint string, timeout time.Duration) bool {
+	done := make(chan error, 1)
+	go func() {
+		_, err := os.Lstat(filepath.Join(mountpoint, ".mimus-check-collegamento"))
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		return errors.Is(err, os.ErrNotExist)
+	case <-time.After(timeout):
+		return false
+	}
+}
+
+// mimusUnmountLater starts a watcher, detached from this process (it
+// survives launchd stopping the service): in 30 s, if no new service
+// listens on the port, the folder is unmounted
+func mimusUnmountLater(mountpoint string) {
+	host, port, err := net.SplitHostPort(nfs.Opt.ListenAddr)
+	if err != nil {
+		return
+	}
+	if host == "" {
+		host = "127.0.0.1"
+	}
+	script := `exec >>"$4" 2>&1
+echo "$(date) servizio fermato: controllo tra 30 s"
+sleep 30
+if nc -z "$2" "$3"; then
+  echo "$(date) servizio ripartito: la cartella resta collegata"
+  exit 0
+fi
+for i in 1 2 3; do
+  diskutil unmount force "$1" && exit 0
+  umount -f "$1" && exit 0
+  sleep 2
+done`
+	logFile := filepath.Join(os.TempDir(), "mimus-scollega.log")
+	cmd := exec.Command("/bin/sh", "-c", script, "sh", mountpoint, host, port, logFile)
+	cmd.Env = append(os.Environ(), "PATH=/usr/sbin:/usr/bin:/sbin:/bin")
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true}
+	if err := cmd.Start(); err != nil {
+		fs.Errorf(nil, "controllo della cartella dopo l'arresto non avviato: %v", err)
+		return
+	}
+	_ = cmd.Process.Release()
+}
