+++ b/vfs/vfscache/mimus_test.go
@@ -0,0 +1,64 @@
+package vfscache
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/config"
+	"github.com/rclone/rclone/fstest"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// a copy with changes not yet uploaded whose metadata is damaged (power
+// loss while saving it) is put aside, never deleted
+func TestMimusQuarantineBadMetadata(t *testing.T) {
+	old := config.GetCacheDir()
+	require.NoError(t, config.SetCacheDir(t.TempDir()))
+	t.Cleanup(func() { _ = config.SetCacheDir(old) })
+	opt := vfscommon.Opt
+	opt.CachePollInterval = 0
+	opt.WriteBack = fs.Duration(time.Hour) // never uploaded during the test
+	r := fstest.NewRun(t)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	c, err := New(ctx, r.Fremote, &opt, addVirtual)
+	require.NoError(t, err)
+	for _, name := range []string{"dir/vuoti.txt", "dir/rotti.txt"} {
+		item := c.Item(name)
+		require.NoError(t, item.Open(nil))
+		_, err = item.WriteAt([]byte("modifica non caricata"), 0)
+		require.NoError(t, err)
+		require.NoError(t, item.Close(nil))
+		require.True(t, item.IsDirty())
+	}
+	// metadata saved atomically: no temporary left behind
+	matches, _ := filepath.Glob(filepath.Join(c.metaRoot, "dir", "*"+mimusMetaTmp))
+	assert.Empty(t, matches)
+	require.NoError(t, c.SyncToDisk("dir/vuoti.txt"))
+	cancel()
+
+	// power loss: one metadata file empty, one cut in half
+	require.NoError(t, os.WriteFile(c.toOSPathMeta("dir/vuoti.txt"), nil, 0o600))
+	data, err := os.ReadFile(c.toOSPathMeta("dir/rotti.txt"))
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(c.toOSPathMeta("dir/rotti.txt"), data[:len(data)/2], 0o600))
+
+	ctx2, cancel2 := context.WithCancel(context.Background())
+	defer cancel2()
+	c2, err := New(ctx2, r.Fremote, &opt, addVirtual)
+	require.NoError(t, err)
+	for _, name := range []string{"dir/vuoti.txt", "dir/rotti.txt"} {
+		assert.False(t, c2.State(name).Cached, name)
+		found, _ := filepath.Glob(filepath.Join(config.GetCacheDir(), "recuperati", "*", "dir", filepath.Base(name)))
+		require.Len(t, found, 1, name)
+		got, err := os.ReadFile(found[0])
+		require.NoError(t, err)
+		assert.Equal(t, "modifica non caricata", string(got))
+	}
+}
