+++ b/vfs/vfscache/mimus.go
@@ -0,0 +1,166 @@
+package vfscache
+
+// MIMUS: state of a file in the cache (for the Finder: on this Mac, only on
+// the server, waiting to be uploaded) and removal of the local copy on
+// request.
+
+import (
+	"context"
+	"errors"
+	"os"
+	"sort"
+	"strings"
+)
+
+// ItemState describes a file in the cache
+type ItemState struct {
+	Known       bool // the cache has an entry for the file
+	Cached      bool // part or all of the file is on this computer
+	Complete    bool // the whole file is on this computer
+	Dirty       bool // changed here, not yet uploaded
+	Open        bool // in use
+	Size        int64
+	Fingerprint string // of the remote version the copy comes from
+}
+
+// peek returns the item for name if the cache has one, without creating it
+func (c *Cache) peek(name string) *Item {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.item[clean(name)]
+}
+
+// State returns the cache state of the file name. Never adds an entry to
+// the cache (the Finder asks for every file it shows).
+func (c *Cache) State(name string) (st ItemState) {
+	item := c.peek(name)
+	if item == nil {
+		return st
+	}
+	item.mu.Lock()
+	defer item.mu.Unlock()
+	st.Known = true
+	st.Size = item.info.Size
+	st.Fingerprint = item.info.Fingerprint
+	st.Cached = item._exists()
+	st.Complete = st.Cached && item._present()
+	st.Dirty = item.info.Dirty
+	st.Open = item.opens != 0
+	return st
+}
+
+// Names returns the files in the cache inside the folder dir ("" = all),
+// sorted
+func (c *Cache) Names(dir string) []string {
+	dir = clean(dir)
+	prefix := dir + "/"
+	c.mu.Lock()
+	var out []string
+	for name := range c.item {
+		if dir == "" || dir == "." || name == dir || strings.HasPrefix(name, prefix) {
+			out = append(out, name)
+		}
+	}
+	c.mu.Unlock()
+	sort.Strings(out)
+	return out
+}
+
+// Evict removes the local copy of the file name, but only if it is not
+// open, has no changes still to upload and the remote allows it (the
+// EvictionChecker checks that the file is safe on the server). Returns true
+// if the copy has been removed (or there was none).
+func (c *Cache) Evict(ctx context.Context, name string) bool {
+	name = clean(name)
+	st := c.State(name)
+	if !st.Cached {
+		return true // nothing on this computer
+	}
+	if st.Dirty || st.Open {
+		return false
+	}
+	if checker, ok := c.fremote.(EvictionChecker); ok && !checker.CacheEvictionAllowed(ctx, name) {
+		return false
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	item, ok := c.item[name]
+	if !ok {
+		return true
+	}
+	c.removeNotInUse(item, 0, false) // re-checks opens and changes
+	_, still := c.item[name]
+	return !still
+}
+
+// ReadLocal reads from the local copy of name at off. Only for a complete
+// copy with nothing to upload: used to compare it with a file on the server.
+func (c *Cache) ReadLocal(name string, p []byte, off int64) (int, error) {
+	name = clean(name)
+	st := c.State(name)
+	if !st.Complete || st.Dirty {
+		return 0, errors.New("copia locale non completa")
+	}
+	fd, err := os.Open(c.toOSPath(name))
+	if err != nil {
+		return 0, err
+	}
+	defer func() { _ = fd.Close() }()
+	return fd.ReadAt(p, off)
+}
+
+// EnsureComplete downloads the parts of the file not yet on this computer.
+// MIMUS: called before changing a copy that is not complete. The missing
+// parts must come from the version being changed, now: later (offline, or
+// after someone changed the file on the server) they could only come from
+// another version, and the result would be a mix of the two.
+func (item *Item) EnsureComplete() error {
+	item.mu.Lock()
+	defer item.mu.Unlock()
+	if item.info.Size <= 0 || item._present() {
+		return nil
+	}
+	return item._ensure(0, item.info.Size)
+}
+
+// SyncToDisk makes the local copy of name and its metadata durable (on
+// disk, not only in memory). MIMUS: called when the Mac asks for it (NFS
+// COMMIT on close or fsync), so a power loss right after a save does not
+// lose it.
+func (c *Cache) SyncToDisk(name string) error {
+	name = clean(name)
+	item := c.peek(name)
+	if item == nil {
+		return nil
+	}
+	item.mu.Lock()
+	defer item.mu.Unlock()
+	if item.fd != nil {
+		if err := item.fd.Sync(); err != nil {
+			return err
+		}
+	} else if fd, err := os.OpenFile(c.toOSPath(name), os.O_RDWR, 0); err == nil {
+		err = fd.Sync()
+		if cerr := fd.Close(); err == nil {
+			err = cerr
+		}
+		if err != nil {
+			return err
+		}
+	} else if !os.IsNotExist(err) {
+		return err
+	}
+	return item._saveMeta(true)
+}
+
+// IsStale: fp marks a copy to be downloaded again (see staleFingerprint)
+func IsStale(fp string) bool { return fp == staleFingerprint }
+
+// SetBase records which remote version a new local file (not uploaded yet)
+// replaces, when it takes the name of an existing file: it is then uploaded
+// over it only if that version did not change meanwhile (MIMUS)
+func (c *Cache) SetBase(name, fingerprint string) {
+	if item := c.peek(name); item != nil {
+		item.adoptFingerprint(fingerprint)
+	}
+}
