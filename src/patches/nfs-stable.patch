diff --git a/cmd/serve/nfs/mimus_cache.go b/cmd/serve/nfs/mimus_cache.go
new file mode 100644
--- /dev/null
+++ b/cmd/serve/nfs/mimus_cache.go
@@ -0,0 +1,188 @@
+//go:build unix
+
+package nfs
+
+// MIMUS: NFS file handles that stay valid when the service restarts.
+//
+// The handle of a file is the MD5 of its path: the same in every run. The
+// way back (handle -> path) is kept in memory and appended to a small log
+// (one line per path ever handed out), read again at start. So after a
+// restart (update, «Riavvia collegamento», crash) the Mac keeps using the
+// folder it has mounted, with the handles it already has: no unmount, no
+// remount, nothing for the Finder to notice.
+
+import (
+	"bufio"
+	"crypto/md5"
+	"encoding/hex"
+	"fmt"
+	"math"
+	"os"
+	"path"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+
+	billy "github.com/go-git/go-billy/v5"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/config"
+	"github.com/rclone/rclone/lib/encoder"
+)
+
+const mimusLogMax = 64 << 20 // rewritten (only live paths) above this size
+
+type mimusHandler struct {
+	mu      sync.RWMutex
+	billyFS billy.Filesystem
+	paths   map[[md5.Size]byte]string
+	file    string
+	log     *os.File
+	written int64
+}
+
+func newMimusHandler(h *Handler) (*mimusHandler, error) {
+	dir := h.opt.HandleCacheDir
+	if dir == "" {
+		dir = filepath.Join(config.GetCacheDir(), "serve-nfs-handle-cache-mimus",
+			encoder.OS.ToStandardName(fs.ConfigString(h.vfs.Fs())))
+	}
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return nil, fmt.Errorf("nfs handle cache: %w", err)
+	}
+	mh := &mimusHandler{
+		billyFS: h.billyFS,
+		paths:   map[[md5.Size]byte]string{},
+		file:    filepath.Join(dir, "handles.log"),
+	}
+	mh.load()
+	if err := mh.openLog(mh.written > mimusLogMax); err != nil {
+		return nil, err
+	}
+	fs.Infof("nfs", "handle stabili in %q (%d noti)", mh.file, len(mh.paths))
+	return mh, nil
+}
+
+// load reads the log: "hex<TAB>quoted path", or "hex<TAB>-" for a handle
+// no longer valid
+func (mh *mimusHandler) load() {
+	f, err := os.Open(mh.file)
+	if err != nil {
+		return
+	}
+	defer func() { _ = f.Close() }()
+	sc := bufio.NewScanner(f)
+	sc.Buffer(make([]byte, 64*1024), 1<<20)
+	for sc.Scan() {
+		line := sc.Text()
+		mh.written += int64(len(line) + 1)
+		hexSum, rest, ok := strings.Cut(line, "\t")
+		var key [md5.Size]byte
+		if !ok || hex.DecodedLen(len(hexSum)) != md5.Size {
+			continue
+		}
+		if _, err := hex.Decode(key[:], []byte(hexSum)); err != nil {
+			continue
+		}
+		if rest == "-" {
+			delete(mh.paths, key)
+			continue
+		}
+		if p, err := strconv.Unquote(rest); err == nil {
+			mh.paths[key] = p
+		}
+	}
+}
+
+// openLog opens the log for appending; compact = rewrite it first with the
+// live paths only
+func (mh *mimusHandler) openLog(compact bool) error {
+	if compact {
+		tmp := mh.file + ".tmp"
+		f, err := os.OpenFile(tmp, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o600)
+		if err != nil {
+			return fmt.Errorf("nfs handle cache: %w", err)
+		}
+		w := bufio.NewWriter(f)
+		mh.written = 0
+		for key, p := range mh.paths {
+			n, _ := fmt.Fprintf(w, "%x\t%s\n", key, strconv.Quote(p))
+			mh.written += int64(n)
+		}
+		if err = w.Flush(); err == nil {
+			err = f.Close()
+		} else {
+			_ = f.Close()
+		}
+		if err == nil {
+			err = os.Rename(tmp, mh.file)
+		}
+		if err != nil {
+			return fmt.Errorf("nfs handle cache: %w", err)
+		}
+	}
+	f, err := os.OpenFile(mh.file, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o600)
+	if err != nil {
+		return fmt.Errorf("nfs handle cache: %w", err)
+	}
+	mh.log = f
+	return nil
+}
+
+// ToHandle returns the handle of the file at splitPath (always the same)
+func (mh *mimusHandler) ToHandle(f billy.Filesystem, splitPath []string) []byte {
+	fullPath := path.Join(splitPath...)
+	key := md5.Sum([]byte(fullPath))
+	mh.mu.RLock()
+	p, ok := mh.paths[key]
+	mh.mu.RUnlock()
+	if !ok || p != fullPath {
+		mh.mu.Lock()
+		mh.paths[key] = fullPath
+		n, err := fmt.Fprintf(mh.log, "%x\t%s\n", key, strconv.Quote(fullPath))
+		mh.written += int64(n)
+		if err != nil {
+			fs.Errorf("nfs", "handle cache: %v", err)
+		}
+		mh.mu.Unlock()
+	}
+	return key[:]
+}
+
+// FromHandle returns the file a handle stands for
+func (mh *mimusHandler) FromHandle(fh []byte) (billy.Filesystem, []string, error) {
+	var key [md5.Size]byte
+	if len(fh) != md5.Size {
+		return nil, nil, errStaleHandle
+	}
+	copy(key[:], fh)
+	mh.mu.RLock()
+	p, ok := mh.paths[key]
+	mh.mu.RUnlock()
+	if !ok {
+		return nil, nil, errStaleHandle
+	}
+	return mh.billyFS, strings.Split(p, "/"), nil
+}
+
+// InvalidateHandle forgets a handle (file renamed or deleted)
+func (mh *mimusHandler) InvalidateHandle(f billy.Filesystem, fh []byte) error {
+	var key [md5.Size]byte
+	if len(fh) != md5.Size {
+		return nil
+	}
+	copy(key[:], fh)
+	mh.mu.Lock()
+	defer mh.mu.Unlock()
+	if _, ok := mh.paths[key]; ok {
+		delete(mh.paths, key)
+		n, _ := fmt.Fprintf(mh.log, "%x\t-\n", key)
+		mh.written += int64(n)
+	}
+	return nil
+}
+
+// HandleLimit is the number of handles that can be kept
+func (mh *mimusHandler) HandleLimit() int {
+	return math.MaxInt
+}
diff --git a/cmd/serve/nfs/mimus_cache_test.go b/cmd/serve/nfs/mimus_cache_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/serve/nfs/mimus_cache_test.go
@@ -0,0 +1,51 @@
+//go:build unix
+
+package nfs
+
+import (
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// handles survive a restart (a new handler reading the same log)
+func TestMimusHandlesStable(t *testing.T) {
+	dir := t.TempDir()
+	h := &Handler{opt: Options{HandleCacheDir: dir}, billyFS: &FS{}}
+	mh, err := newMimusHandler(h)
+	require.NoError(t, err)
+	root := mh.ToHandle(nil, []string{})
+	a := mh.ToHandle(nil, []string{"Doc", "città\nstrana.txt"})
+	b := mh.ToHandle(nil, []string{"Doc", "b.txt"})
+	assert.Equal(t, a, mh.ToHandle(nil, []string{"Doc", "città\nstrana.txt"}))
+	require.NoError(t, mh.InvalidateHandle(nil, b))
+	_, _, err = mh.FromHandle(b)
+	assert.Error(t, err)
+
+	// restart
+	mh2, err := newMimusHandler(h)
+	require.NoError(t, err)
+	_, p, err := mh2.FromHandle(a)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"Doc", "città\nstrana.txt"}, p)
+	_, p, err = mh2.FromHandle(root)
+	require.NoError(t, err)
+	assert.Equal(t, []string{""}, p)
+	_, _, err = mh2.FromHandle(b)
+	assert.Error(t, err, "invalidated handle comes back")
+	assert.Equal(t, root, mh2.ToHandle(nil, []string{}))
+
+	// compaction keeps the live handles only
+	mh2.written = mimusLogMax + 1
+	_ = mh2.log.Close()
+	require.NoError(t, mh2.openLog(true))
+	mh3, err := newMimusHandler(h)
+	require.NoError(t, err)
+	_, _, err = mh3.FromHandle(a)
+	require.NoError(t, err)
+	data, err := os.ReadFile(mh3.file)
+	require.NoError(t, err)
+	assert.NotContains(t, string(data), "\t-\n")
+}
