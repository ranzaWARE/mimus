+// handles survive a restart (a new handler reading the same log)
+func TestMimusHandlesStable(t *testing.T) {
+	dir := t.TempDir()
+	h := &Handler{opt: Options{HandleCacheDir: dir}, billyFS: &FS{}}
+	mh, err := newMimusHandler(h)
+	require.NoError(t, err)
+	root := mh.ToHandle(nil, []string{})
+	a := mh.ToHandle(nil, []string{"Doc", "città\nstrana.txt"})
+	b := mh.ToHandle(nil, []string{"Doc", "b.txt"})
+	assert.Equal(t, a, mh.ToHandle(nil, []string{"Doc", "città\nstrana.txt"}))
+	require.NoError(t, mh.InvalidateHandle(nil, b))
+	_, _, err = mh.FromHandle(b)
+	assert.Error(t, err)
+
+	// restart
+	mh2, err := newMimusHandler(h)
+	require.NoError(t, err)
+	_, p, err := mh2.FromHandle(a)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"Doc", "città\nstrana.txt"}, p)
+	_, p, err = mh2.FromHandle(root)
+	require.NoError(t, err)
+	assert.Equal(t, []string{""}, p)
+	_, _, err = mh2.FromHandle(b)
+	assert.Error(t, err, "invalidated handle comes back")
+	assert.Equal(t, root, mh2.ToHandle(nil, []string{}))
+
+	// compaction keeps the live handles only
+	mh2.written = mimusLogMax + 1
+	_ = mh2.log.Close()
+	require.NoError(t, mh2.openLog(true))
+	mh3, err := newMimusHandler(h)
+	require.NoError(t, err)
+	_, _, err = mh3.FromHandle(a)
+	require.NoError(t, err)
+	data, err := os.ReadFile(mh3.file)
+	require.NoError(t, err)
+	assert.NotContains(t, string(data), "\t-\n")
+}
+
+// a rename moves the handle with the file: an app with the file open goes on
+// using it; a new file at the old path gets another handle; the files in a
+// renamed folder follow it; all of it also after a restart
+func TestMimusHandlesFollowRename(t *testing.T) {
+	ctx := context.Background()
+	root := t.TempDir()
+	require.NoError(t, os.MkdirAll(filepath.Join(root, "Doc", "Sotto"), 0o755))
+	for _, f := range []string{"Doc/Acr1.tmp", "Doc/Logo.ai", "Doc/Sotto/x.txt"} {
+		require.NoError(t, os.WriteFile(filepath.Join(root, f), []byte(f), 0o644))
+	}
+	rfs, err := rclonefs.NewFs(ctx, root)
+	require.NoError(t, err)
+	v := vfs.New(rfs, nil)
+	defer v.Shutdown()
+	h := &Handler{opt: Options{HandleCacheDir: t.TempDir()}, billyFS: &FS{vfs: v}}
+	mh, err := newMimusHandler(h)
+	require.NoError(t, err)
+	h.Cache = mh
+
+	tmp := mh.ToHandle(nil, []string{"Doc", "Acr1.tmp"})
+	logo := mh.ToHandle(nil, []string{"Doc", "Logo.ai"})
+	sub := mh.ToHandle(nil, []string{"Doc", "Sotto", "x.txt"})
+
+	// safe save: the temporary copy takes the place of the document
+	require.NoError(t, h.billyFS.Rename("Doc/Acr1.tmp", "Doc/Logo.ai"))
+	require.NoError(t, h.RenameHandle(nil, []string{"Doc", "Acr1.tmp"}, []string{"Doc", "Logo.ai"}))
+	_, p, err := mh.FromHandle(tmp)
+	require.NoError(t, err, "the open temporary copy must not become stale")
+	assert.Equal(t, []string{"Doc", "Logo.ai"}, p)
+	_, _, err = mh.FromHandle(logo)
+	assert.Error(t, err, "the replaced document is gone")
+	assert.Equal(t, tmp, mh.ToHandle(nil, []string{"Doc", "Logo.ai"}))
+
+	// a new file at the old name is another file
+	again := mh.ToHandle(nil, []string{"Doc", "Acr1.tmp"})
+	assert.NotEqual(t, tmp, again)
+	_, p, err = mh.FromHandle(again)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"Doc", "Acr1.tmp"}, p)
+
+	// a folder renamed: what is inside follows it
+	require.NoError(t, h.billyFS.Rename("Doc/Sotto", "Doc/Nuova"))
+	require.NoError(t, h.RenameHandle(nil, []string{"Doc", "Sotto"}, []string{"Doc", "Nuova"}))
+	_, p, err = mh.FromHandle(sub)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"Doc", "Nuova", "x.txt"}, p)
+
+	// restart
+	mh2, err := newMimusHandler(h)
+	require.NoError(t, err)
+	for key, want := range map[string][]string{string(tmp): {"Doc", "Logo.ai"}, string(again): {"Doc", "Acr1.tmp"}, string(sub): {"Doc", "Nuova", "x.txt"}} {
+		_, p, err := mh2.FromHandle([]byte(key))
+		require.NoError(t, err)
+		assert.Equal(t, want, p)
+	}
+	_, _, err = mh2.FromHandle(logo)
+	assert.Error(t, err)
+	assert.Equal(t, again, mh2.ToHandle(nil, []string{"Doc", "Acr1.tmp"}))
+}
