+
+// MIMUS: a change notified by the backend gives the folders a new date
+// (NFS clients refresh open windows), and a re-read does not take it back
+func TestDirChangeNotifyTouches(t *testing.T) {
+	_, vfs, dir, file1 := dirCreate(t)
+	_, err := vfs.Stat(file1.Path)
+	require.NoError(t, err)
+	root, err := vfs.Root()
+	require.NoError(t, err)
+	rootBefore, dirBefore := root.ModTime(), dir.ModTime()
+	time.Sleep(10 * time.Millisecond)
+
+	root.changeNotify("dir", fs.EntryDirectory)
+	assert.True(t, root.ModTime().After(rootBefore), "root date not changed")
+	assert.True(t, dir.ModTime().After(dirBefore), "dir date not changed")
+	touched := dir.ModTime()
+
+	// re-reading the root (dir's date from the remote is older) keeps it
+	_, err = vfs.Stat("dir")
+	require.NoError(t, err)
+	assert.False(t, root.read.IsZero())
+	assert.Equal(t, touched, dir.ModTime())
+}
