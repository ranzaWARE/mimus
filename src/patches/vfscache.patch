+// suffix of the metadata being written (see _saveMeta)
+const mimusMetaTmp = ".mimus-tmp"
+
+// _quarantine: MIMUS. The metadata of a copy could not be read (crash or
+// power loss while saving it, file damaged): rclone would delete the copy,
+// and with it any changes not yet uploaded. It is moved aside instead, in
+// the "recuperati" folder next to the cache, and nothing is uploaded from
+// it (it may be incomplete). Returns true if moved.
+//
+// call with the lock held
+func (item *Item) _quarantine(reason string) bool {
+	if filepath.Ext(item.name) == mimusMetaTmp {
+		return false
+	}
+	osPath := item.c.toOSPath(item.name) // No locking in Cache
+	fi, err := os.Stat(osPath)
+	if err != nil || !fi.Mode().IsRegular() || fi.Size() == 0 {
+		return false
+	}
+	dst := filepath.Join(config.GetCacheDir(), "recuperati", time.Now().Format("2006-01-02 150405"), toOSPath(item.name))
+	if err = os.MkdirAll(filepath.Dir(dst), 0o700); err == nil {
+		err = os.Rename(osPath, dst)
+	}
+	if err != nil {
+		fs.Errorf(item.name, "vfs cache: copia con metadati illeggibili non messa da parte: %v", err)
+		return false
+	}
+	fs.Errorf(item.name, "vfs cache: %s: la copia su questo computer è stata messa da parte in %q (potrebbe contenere modifiche non caricate)", reason, dst)
+	return true
+}
