+// ---- mimus patch: remote-controlled eviction and upload conflicts ----
+
+// EvictionChecker can be implemented by the remote to veto the removal of
+// cache files, e.g. while the remote is unreachable or when the file is no
+// longer on the remote (the local copy would be the only one left).
+type EvictionChecker interface {
+	CacheEvictionAllowed(ctx context.Context, remote string) bool
+}
+
+// UploadConflictResolver can be implemented by the remote to check, before a
+// locally modified file is uploaded, whether the remote copy changed meanwhile.
+//
+// baseFingerprint is the fingerprint of the remote version the local copy
+// started from ("" for a new file). The returned action is:
+//
+//   - "" or "overwrite": upload normally (current, if not nil, is the remote
+//     object to replace)
+//   - "keepboth": upload the local copy as newName, leave the remote file alone
+//   - "discard": drop the local changes, keep the remote file
+type UploadConflictResolver interface {
+	ResolveUploadConflict(ctx context.Context, name, baseFingerprint string, fast bool) (action, newName string, current fs.Object, err error)
+}
+
+// evictionCandidates returns the names of the items selected by keep,
+// sorted oldest access first. Call with c.mu held.
+func (c *Cache) evictionCandidates(keep func(item *Item) bool) []string {
+	var items Items
+	names := make(map[*Item]string)
+	for name, item := range c.item {
+		if keep(item) {
+			items = append(items, item)
+			names[item] = name
+		}
+	}
+	sort.Sort(items)
+	out := make([]string, len(items))
+	for i, item := range items {
+		out[i] = names[item]
+	}
+	return out
+}
+
+// purgeOldChecked is purgeOld asking the remote before removing anything.
+// The remote is queried without holding the cache lock.
+func (c *Cache) purgeOldChecked(maxAge time.Duration, checker EvictionChecker) {
+	c.mu.Lock()
+	candidates := c.evictionCandidates(func(item *Item) bool { return item.isOldCandidate(maxAge) })
+	c.mu.Unlock()
+	for _, name := range candidates {
+		if !checker.CacheEvictionAllowed(context.Background(), name) {
+			continue
+		}
+		c.mu.Lock()
+		if item, ok := c.item[name]; ok {
+			c.removeNotInUse(item, maxAge, false) // re-checks age, opens and dirty
+		}
+		c.mu.Unlock()
+	}
+	c.mu.Lock()
+	if c.quotasOK() {
+		c.outOfSpace = false
+		c.cond.Broadcast()
+	}
+	c.mu.Unlock()
+}
+
+// purgeOverQuotaChecked is purgeOverQuota asking the remote first
+func (c *Cache) purgeOverQuotaChecked(checker EvictionChecker) {
+	c.updateUsed()
+	c.mu.Lock()
+	if c.quotasOK() {
+		c.mu.Unlock()
+		return
+	}
+	candidates := c.evictionCandidates(func(item *Item) bool { return !item.inUse() && !item.IsDirty() })
+	c.mu.Unlock()
+	for _, name := range candidates {
+		c.mu.Lock()
+		ok := c.quotasOK()
+		c.mu.Unlock()
+		if ok {
+			break
+		}
+		if !checker.CacheEvictionAllowed(context.Background(), name) {
+			continue
+		}
+		c.mu.Lock()
+		if item, found := c.item[name]; found && !item.inUse() {
+			c.removeNotInUse(item, 0, false)
+		}
+		c.mu.Unlock()
+	}
+	c.mu.Lock()
+	if c.quotasOK() {
+		c.outOfSpace = false
+		c.cond.Broadcast()
+	}
+	c.mu.Unlock()
+}
+
+// purgeCleanChecked is purgeClean asking the remote first
+func (c *Cache) purgeCleanChecked(checker EvictionChecker) {
+	c.mu.Lock()
+	if c.quotasOK() {
+		c.mu.Unlock()
+		return
+	}
+	candidates := c.evictionCandidates(func(item *Item) bool { return !item.IsDirty() })
+	c.mu.Unlock()
+	for _, name := range candidates {
+		c.mu.Lock()
+		ok := c.quotasOK()
+		c.mu.Unlock()
+		if ok {
+			break
+		}
+		if !checker.CacheEvictionAllowed(context.Background(), name) {
+			continue
+		}
+		c.mu.Lock()
+		if item, found := c.item[name]; found {
+			resetResult, spaceFreed, err := item.Reset()
+			c.used -= spaceFreed
+			fs.Infof(c.fremote, "vfs cache purgeClean item.Reset %s: %s, freed %d bytes", name, resetResult.String(), spaceFreed)
+			if resetResult == RemovedNotInUse {
+				delete(c.item, name)
+			}
+			if err != nil {
+				c.errItems[name] = err
+			}
+		}
+		c.mu.Unlock()
+	}
+	c.mu.Lock()
+	c.outOfSpace = false
+	c.cond.Broadcast()
+	c.mu.Unlock()
+}
+
+// ---- end mimus patch ----
+
 // purgeOld gets rid of any files that are over age
 func (c *Cache) purgeOld(maxAge time.Duration) {
+	if checker, ok := c.fremote.(EvictionChecker); ok {
+		c.purgeOldChecked(maxAge, checker)
+		return
+	}
 	c.mu.Lock()
 	defer c.mu.Unlock()
 	// cutoff := time.Now().Add(-maxAge)
