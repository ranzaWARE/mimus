+// touchDir sets the modification time of a cached directory to now
+func (d *Dir) touchDir(absPath string) {
+	if dir, ok := d.vfs.root.cachedNode(absPath).(*Dir); ok {
+		dir.modTimeMu.Lock()
+		if now := time.Now(); now.After(dir.modTime) {
+			dir.modTime = now
+		}
+		dir.modTimeMu.Unlock()
+	}
 }
 
