diff --git a/cmd/serve/nfs/mimus_cache.go b/cmd/serve/nfs/mimus_cache.go
new file mode 100644
--- /dev/null
+++ b/cmd/serve/nfs/mimus_cache.go
@@ -0,0 +1,286 @@
+//go:build unix
+
+package nfs
+
+// MIMUS: NFS file handles that stay valid when the service restarts and
+// that follow a file when it is renamed.
+//
+// The handle of a file is the MD5 of its path the first time it is seen
+// (the same in every run). The way back (handle -> path) is kept in memory
+// and appended to a small log (one line per change), read again at start.
+// So after a restart (update, «Riavvia collegamento», crash) the Mac keeps
+// using the folder it has mounted, with the handles it already has: no
+// unmount, no remount, nothing for the Finder to notice.
+//
+// A rename moves the handle with the file (and the handles of everything in
+// a renamed folder), as NFS requires: an app that keeps the file open, as
+// the safe save of Adobe apps does with its temporary copy, goes on reading
+// and writing it under the new name. A new file later created at the old
+// path gets a handle of its own.
+
+import (
+	"bufio"
+	"crypto/md5"
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"math"
+	"os"
+	"path"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+
+	billy "github.com/go-git/go-billy/v5"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/config"
+	"github.com/rclone/rclone/lib/encoder"
+)
+
+const mimusLogMax = 64 << 20 // rewritten (only live paths) above this size
+
+type mimusHandler struct {
+	mu      sync.RWMutex
+	billyFS billy.Filesystem
+	paths   map[[md5.Size]byte]string // handle -> path
+	byPath  map[string][md5.Size]byte // path -> handle
+	file    string
+	log     *os.File
+	written int64
+}
+
+func newMimusHandler(h *Handler) (*mimusHandler, error) {
+	dir := h.opt.HandleCacheDir
+	if dir == "" {
+		dir = filepath.Join(config.GetCacheDir(), "serve-nfs-handle-cache-mimus",
+			encoder.OS.ToStandardName(fs.ConfigString(h.vfs.Fs())))
+	}
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return nil, fmt.Errorf("nfs handle cache: %w", err)
+	}
+	mh := &mimusHandler{
+		billyFS: h.billyFS,
+		paths:   map[[md5.Size]byte]string{},
+		byPath:  map[string][md5.Size]byte{},
+		file:    filepath.Join(dir, "handles.log"),
+	}
+	mh.load()
+	if err := mh.openLog(mh.written > mimusLogMax); err != nil {
+		return nil, err
+	}
+	fs.Infof("nfs", "handle stabili in %q (%d noti)", mh.file, len(mh.paths))
+	return mh, nil
+}
+
+// load reads the log: "hex<TAB>quoted path", or "hex<TAB>-" for a handle
+// no longer valid
+func (mh *mimusHandler) load() {
+	f, err := os.Open(mh.file)
+	if err != nil {
+		return
+	}
+	defer func() { _ = f.Close() }()
+	sc := bufio.NewScanner(f)
+	sc.Buffer(make([]byte, 64*1024), 1<<20)
+	for sc.Scan() {
+		line := sc.Text()
+		mh.written += int64(len(line) + 1)
+		hexSum, rest, ok := strings.Cut(line, "\t")
+		var key [md5.Size]byte
+		if !ok || hex.DecodedLen(len(hexSum)) != md5.Size {
+			continue
+		}
+		if _, err := hex.Decode(key[:], []byte(hexSum)); err != nil {
+			continue
+		}
+		if rest == "-" {
+			mh._forget(key)
+			continue
+		}
+		if p, err := strconv.Unquote(rest); err == nil {
+			mh._set(key, p)
+		}
+	}
+}
+
+// _set: handle key is the file at p (call with the lock held, or at load)
+func (mh *mimusHandler) _set(key [md5.Size]byte, p string) {
+	if old, ok := mh.paths[key]; ok && mh.byPath[old] == key {
+		delete(mh.byPath, old)
+	}
+	if other, ok := mh.byPath[p]; ok && other != key {
+		delete(mh.paths, other) // the path now belongs to this handle
+	}
+	mh.paths[key] = p
+	mh.byPath[p] = key
+}
+
+func (mh *mimusHandler) _forget(key [md5.Size]byte) {
+	if p, ok := mh.paths[key]; ok {
+		if mh.byPath[p] == key {
+			delete(mh.byPath, p)
+		}
+		delete(mh.paths, key)
+	}
+}
+
+func (mh *mimusHandler) _log(key [md5.Size]byte, p string) {
+	line := strconv.Quote(p)
+	if p == "\x00" {
+		line = "-"
+	}
+	n, err := fmt.Fprintf(mh.log, "%x\t%s\n", key, line)
+	mh.written += int64(n)
+	if err != nil {
+		fs.Errorf("nfs", "handle cache: %v", err)
+	}
+}
+
+// openLog opens the log for appending; compact = rewrite it first with the
+// live paths only
+func (mh *mimusHandler) openLog(compact bool) error {
+	if compact {
+		tmp := mh.file + ".tmp"
+		f, err := os.OpenFile(tmp, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o600)
+		if err != nil {
+			return fmt.Errorf("nfs handle cache: %w", err)
+		}
+		w := bufio.NewWriter(f)
+		mh.written = 0
+		for key, p := range mh.paths {
+			n, _ := fmt.Fprintf(w, "%x\t%s\n", key, strconv.Quote(p))
+			mh.written += int64(n)
+		}
+		if err = w.Flush(); err == nil {
+			err = f.Close()
+		} else {
+			_ = f.Close()
+		}
+		if err == nil {
+			err = os.Rename(tmp, mh.file)
+		}
+		if err != nil {
+			return fmt.Errorf("nfs handle cache: %w", err)
+		}
+	}
+	f, err := os.OpenFile(mh.file, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o600)
+	if err != nil {
+		return fmt.Errorf("nfs handle cache: %w", err)
+	}
+	mh.log = f
+	return nil
+}
+
+// ToHandle returns the handle of the file at splitPath: the one it already
+// has, or the MD5 of the path for a file seen for the first time (a random
+// one if that is taken by a file renamed from this path)
+func (mh *mimusHandler) ToHandle(f billy.Filesystem, splitPath []string) []byte {
+	fullPath := path.Join(splitPath...)
+	mh.mu.RLock()
+	key, ok := mh.byPath[fullPath]
+	mh.mu.RUnlock()
+	if ok {
+		return key[:]
+	}
+	mh.mu.Lock()
+	defer mh.mu.Unlock()
+	if key, ok := mh.byPath[fullPath]; ok {
+		return key[:]
+	}
+	key = md5.Sum([]byte(fullPath))
+	if _, taken := mh.paths[key]; taken {
+		if _, err := rand.Read(key[:]); err != nil {
+			fs.Errorf("nfs", "handle cache: %v", err)
+		}
+	}
+	mh._set(key, fullPath)
+	mh._log(key, fullPath)
+	return key[:]
+}
+
+// FromHandle returns the file a handle stands for
+func (mh *mimusHandler) FromHandle(fh []byte) (billy.Filesystem, []string, error) {
+	var key [md5.Size]byte
+	if len(fh) != md5.Size {
+		return nil, nil, errStaleHandle
+	}
+	copy(key[:], fh)
+	mh.mu.RLock()
+	p, ok := mh.paths[key]
+	mh.mu.RUnlock()
+	if !ok {
+		return nil, nil, errStaleHandle
+	}
+	return mh.billyFS, strings.Split(p, "/"), nil
+}
+
+// InvalidateHandle forgets a handle (file renamed or deleted)
+func (mh *mimusHandler) InvalidateHandle(f billy.Filesystem, fh []byte) error {
+	var key [md5.Size]byte
+	if len(fh) != md5.Size {
+		return nil
+	}
+	copy(key[:], fh)
+	mh.mu.Lock()
+	defer mh.mu.Unlock()
+	if _, ok := mh.paths[key]; ok {
+		mh._forget(key)
+		mh._log(key, "\x00")
+	}
+	return nil
+}
+
+// RenameHandle moves the handles of from (and of what is inside it, for a
+// folder) to the new path; the handle of a file replaced at to is dropped
+func (mh *mimusHandler) RenameHandle(f billy.Filesystem, from, to []string) error {
+	src, dst := path.Join(from...), path.Join(to...)
+	if src == dst {
+		return nil
+	}
+	mh.mu.Lock()
+	defer mh.mu.Unlock()
+	if key, ok := mh.byPath[dst]; ok {
+		mh._forget(key)
+		mh._log(key, "\x00")
+	}
+	moved := map[[md5.Size]byte]string{}
+	if key, ok := mh.byPath[src]; ok {
+		moved[key] = dst
+	}
+	if fi, err := mh.billyFS.Stat(dst); err == nil && fi.IsDir() {
+		prefix := src + "/"
+		if src == "" {
+			prefix = ""
+		}
+		for key, p := range mh.paths {
+			if strings.HasPrefix(p, prefix) && p != src {
+				moved[key] = dst + "/" + strings.TrimPrefix(p, prefix)
+			}
+		}
+	}
+	for key := range moved {
+		mh._forget(key)
+	}
+	for key, p := range moved {
+		mh._set(key, p)
+		mh._log(key, p)
+	}
+	return nil
+}
+
+// RenameHandle: the handles follow a renamed file (see mimusHandler); with
+// the other handle caches the old handle is invalidated, as upstream
+func (h *Handler) RenameHandle(f billy.Filesystem, from, to []string) error {
+	if r, ok := h.Cache.(interface {
+		RenameHandle(billy.Filesystem, []string, []string) error
+	}); ok {
+		return r.RenameHandle(f, from, to)
+	}
+	return h.Cache.InvalidateHandle(f, h.Cache.ToHandle(f, from))
+}
+
+// HandleLimit is the number of handles that can be kept
+func (mh *mimusHandler) HandleLimit() int {
+	return math.MaxInt
+}
